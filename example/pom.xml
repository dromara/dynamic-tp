<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.dromara.dynamictp</groupId>
        <artifactId>dynamic-tp-all</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>dynamic-tp-example</artifactId>
    <packaging>pom</packaging>

    <properties>
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <modules>
        <module>example-nacos-cloud</module>
        <module>example-apollo</module>
        <module>example-zookeeper</module>
        <module>example-zookeeper-cloud</module>
        <module>example-consul-cloud</module>
        <module>example-etcd</module>
        <module>example-adapter</module>
        <module>example-huawei-cloud</module>
    </modules>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-deploy-plugin</artifactId>
                <version>${maven-deploy-plugin.version}</version>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- The standalone Nacos Spring Boot starter supports Spring Boot 3, but not Spring Boot 4. -->
        <profile>
            <id>standalone-nacos</id>
            <activation>
                <property>
                    <name>includeStandaloneNacos</name>
                </property>
            </activation>
            <modules>
                <module>example-nacos</module>
            </modules>
        </profile>

        <!-- Spring Cloud Tencent has no Spring Cloud 2025.1 / Spring Boot 4 release yet. -->
        <profile>
            <id>spring-cloud-tencent</id>
            <activation>
                <property>
                    <name>includeSpringCloudTencent</name>
                </property>
            </activation>
            <modules>
                <module>example-polaris-cloud</module>
            </modules>
        </profile>
    </profiles>
</project>
