<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.dromara.dynamictp</groupId>
        <artifactId>dynamic-tp-starter</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>dynamic-tp-starter-configcenter</artifactId>
    <packaging>pom</packaging>

    <modules>
        <module>starter-apollo</module>
        <module>cloud-starter-nacos</module>
        <module>starter-zookeeper</module>
        <module>cloud-starter-zookeeper</module>
        <module>cloud-starter-consul</module>
        <module>starter-etcd</module>
        <module>cloud-starter-huawei</module>
    </modules>

    <dependencies>
        <dependency>
            <groupId>org.dromara.dynamictp</groupId>
            <artifactId>dynamic-tp-spring-boot-starter-common</artifactId>
        </dependency>
    </dependencies>

    <profiles>
        <!-- The standalone Nacos Spring Boot starter supports Spring Boot 3, but not Spring Boot 4. -->
        <profile>
            <id>standalone-nacos</id>
            <activation>
                <property>
                    <name>includeStandaloneNacos</name>
                </property>
            </activation>
            <modules>
                <module>starter-nacos</module>
            </modules>
        </profile>

        <!-- Spring Cloud Tencent has no Spring Cloud 2025.1 / Spring Boot 4 release yet. -->
        <profile>
            <id>spring-cloud-tencent</id>
            <activation>
                <property>
                    <name>includeSpringCloudTencent</name>
                </property>
            </activation>
            <modules>
                <module>cloud-starter-polaris</module>
            </modules>
        </profile>
    </profiles>
</project>
